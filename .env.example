# Set a long random token for first owner registration. Remove after registering.
SETUP_TOKEN=replace-with-at-least-32-random-characters
# Production must use HTTPS; set the exact public origin, without trailing slash.
APP_ORIGIN=https://your-app.up.railway.app
NODE_ENV=production
PORT=3000
# Mount a persistent Railway volume here. SQLite must not use ephemeral storage.
DATA_DIR=/app/data
