# One-time first-owner enrollment secret; set a random value of at least 32 characters.
# After owner enrollment, remove SETUP_TOKEN from Railway variables.
SETUP_TOKEN=replace-with-at-least-32-random-characters

# The exact public HTTPS origin, with no trailing slash.
APP_ORIGIN=https://your-app.up.railway.app
NODE_ENV=production
PORT=3000
DATA_DIR=/data

# Hard account-data cap (decimal bytes). Railway's physical /data volume is separate.
FORGE_MAX_DATA_BYTES=15000000000
FORGE_VOLUME_LABEL=50 GB Railway volume; 15 GB app-data cap

# Generate one stable VAPID key pair per deployment; store the real values in Railway only.
# Never commit a real private key. Configure these to enable closed-app Web Push reminders.
VAPID_SUBJECT=https://github.com/sahilxnahar/Gym
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
PUSH_CHECK_INTERVAL_MS=30000
